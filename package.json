{
  "name": "drydock",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloud coding agent platform: Docker-sandboxed runs, SSE timelines, git delivery.",
  "scripts": {
    "api": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --import tsx src/server/index.ts",
    "web": "vite",
    "build": "vite build && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "sandbox:build": "docker build -t drydock-sandbox:latest -f docker/sandbox.Dockerfile docker",
    "demo": "tsx scripts/demo.ts",
    "record:showcase": "tsx scripts/record-showcase.ts",
    "showcase": "DRYDOCK_MODE=showcase pnpm api"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@hono/node-server": "^2.1.8",
    "hono": "^4.13.18",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
