# API server (port 4100) and web UI (port 4101)
DRYDOCK_PORT=4100
DRYDOCK_DATA_DIR=./data
# anthropic (default, needs ANTHROPIC_API_KEY) | openai (any OpenAI-compatible base URL) | scripted (keyless, deterministic)
DRYDOCK_MODEL_PROVIDER=anthropic
DRYDOCK_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
# openai provider only
DRYDOCK_OPENAI_BASE_URL=http://localhost:11434/v1
DRYDOCK_OPENAI_API_KEY=
# scripted provider only: name of a built-in script
DRYDOCK_SCRIPT=fix-failing-test
DRYDOCK_CONCURRENCY=2
DRYDOCK_MAX_STEPS=40
DRYDOCK_IDLE_TTL_MS=900000
# GitHub delivery target (token stays on the host; never enters the sandbox)
GITHUB_TOKEN=
DRYDOCK_SANDBOX_IMAGE=drydock-sandbox:latest
# URL the sandbox uses to reach this server's /git endpoint
DRYDOCK_SANDBOX_API_URL=http://host.docker.internal:4100
